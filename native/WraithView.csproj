<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WraithView</AssemblyName>
    <RootNamespace>WraithView</RootNamespace>
    <ApplicationIcon>Assets\WraithView.ico</ApplicationIcon>
    <Version>0.9.6</Version>
    <AssemblyVersion>0.9.6.0</AssemblyVersion>
    <FileVersion>0.9.6.0</FileVersion>
    <InformationalVersion>0.9.6</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="WraithView.Tests\**" />
    <None Remove="WraithView.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WraithView.Tests" />
    <InternalsVisibleTo Include="WraithView.CycleTests" />
    <InternalsVisibleTo Include="WraithView.PreviewPositionTests" />
    <Compile Remove="WraithView.PreviewPositionTests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hotkeys\WraithViewHotkeys.ahk" LogicalName="WraithView.Hotkeys.WraithViewHotkeys.ahk" />
    <EmbeddedResource Include="Hotkeys\EVE-X-LICENSE.txt" LogicalName="WraithView.Hotkeys.EVE-X-LICENSE.txt" />
    <EmbeddedResource Include="Hotkeys\Runtime\*" LogicalName="WraithView.Hotkeys.%(Filename)%(Extension)" />
    <Resource Include="Assets\WraithView.ico" />
    <EmbeddedResource Include="Assets\overlay-dist.zip"
                      Condition="Exists('Assets\overlay-dist.zip')"
                      LogicalName="WraithView.Assets.overlay-dist.zip" />
  </ItemGroup>
</Project>
